{
  "name": "@paperclipai/plugin-grafana-cloud",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Expose the whole Grafana Cloud stack — dashboards, alerts, Loki, Tempo, Mimir, Pyroscope, Faro, Synthetic Monitoring, OnCall, IRM, k6, and Cloud Admin — to Paperclip agents as tools, plus light UI surfaces.",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "pnpm --filter @paperclipai/plugin-sdk ensure-build-deps",
    "build": "node ./esbuild.config.mjs",
    "dev": "node ./esbuild.config.mjs --watch",
    "dev:ui": "paperclip-plugin-dev-server --root . --ui-dir dist/ui --port 4178",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "pnpm --filter @paperclipai/plugin-sdk ensure-build-deps && tsc --noEmit"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "keywords": [
    "paperclip",
    "plugin",
    "grafana",
    "grafana-cloud",
    "observability",
    "loki",
    "tempo",
    "mimir",
    "prometheus",
    "oncall",
    "irm"
  ],
  "author": "Paperclip",
  "license": "MIT",
  "devDependencies": {
    "@paperclipai/plugin-sdk": "workspace:*",
    "@types/node": "^24.6.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "esbuild": "^0.27.3",
    "react-dom": "^19.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
